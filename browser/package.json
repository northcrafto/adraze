{
  "name": "adraze-browser",
  "version": "0.1.55",
  "description": "AdRaze – webbläsaren med AdRazes adblocker inbyggd",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-packager . \"AdRaze\" --platform=darwin --arch=x64 --out=dist --overwrite --app-bundle-id=app.adraze.browser --ignore=\"(dist|/\\.git|meta_test\\.js|scan_test\\.js|.*\\.md)\"",
    "build:linux": "electron-builder --linux --x64",
    "build:win": "electron-builder --win --x64",
    "sync": "bash tools/sync-adraze.sh",
    "prestart": "npm run sync",
    "prebuild:mac": "npm run sync",
    "prebuild:linux": "npm run sync && bash tools/build-native.sh",
    "prebuild:win": "npm run sync"
  },
  "author": "Cetto",
  "license": "MPL-2.0",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@electron/packager": "^18.4.4",
    "@tailwindcss/cli": "^4.3.3",
    "electron": "github:castlabs/electron-releases#v44.9.3+wvcus",
    "electron-builder": "^24.13.3",
    "node-addon-api": "^8.9.2",
    "tailwindcss": "^4.3.3"
  },
  "build": {
    "appId": "app.adraze.browser",
    "productName": "AdRaze",
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!dist-installer/**",
      "!build/**",
      "!*.md",
      "!meta_test.js",
      "!scan_test.js",
      "!**/*.map",
      "!**/.git/**",
      "native/adblock/build/Release/adblock_core.node",
      "adraze/lists/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "AdRaze-Setup.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "artifactName": "AdRaze.AppImage",
      "category": "Network"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "northcrafto",
        "repo": "adraze-dl",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AdRaze",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "afterPack": "build/afterPack.js",
    "electronDist": "node_modules/electron/dist",
    "asarUnpack": [
      "native/adblock/build/Release/*.node"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/northcrafto/adraze.git"
  },
  "homepage": "https://adraze.app",
  "bugs": {
    "url": "https://github.com/northcrafto/adraze/issues"
  },
  "productName": "AdRaze"
}
