{
  "name": "adraze-browser",
  "version": "0.1.103",
  "description": "AdRaze – webbläsaren med AdRazes adblocker inbyggd",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "npm run sync && electron-builder --mac",
    "build:linux": "electron-builder --linux --x64",
    "build:win": "electron-builder --win --x64",
    "sync": "bash tools/sync-adraze.sh",
    "prestart": "npm run sync",
    "prebuild:linux": "npm run sync && bash tools/build-native.sh",
    "prebuild:win": "npm run sync"
  },
  "author": "Cetto",
  "license": "MPL-2.0",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@electron/packager": "^18.4.4",
    "@tailwindcss/cli": "^4.3.3",
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "^24.13.3",
    "node-addon-api": "^8.9.2",
    "tailwindcss": "^4.3.3"
  },
  "build": {
    "appId": "app.adraze.browser",
    "productName": "AdRaze",
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!dist-installer/**",
      "!build/**",
      "!*.md",
      "!meta_test.js",
      "!scan_test.js",
      "!**/*.map",
      "!**/.git/**",
      "native/adblock/build/Release/adblock_core.node",
      "adraze/lists/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "AdRaze-Setup.exe"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "artifactName": "AdRaze.AppImage",
      "category": "Network"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "northcrafto",
        "repo": "adraze-dl",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AdRaze",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "afterPack": "build/afterPack.js",
    "electronDist": "node_modules/electron/dist",
    "asarUnpack": [
      "native/adblock/build/Release/*.node"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "AdRaze-mac.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/native/adblock/build/Release/*.node",
      "minimumSystemVersion": "12.0",
      "notarize": {
        "teamId": "TSW6WVMNJ8"
      },
      "extendInfo": {
        "NSCameraUsageDescription": "En webbplats vill använda kameran.",
        "NSMicrophoneUsageDescription": "En webbplats vill använda mikrofonen.",
        "NSLocationUsageDescription": "En webbplats vill veta var du är.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Webbadress",
            "CFBundleURLSchemes": [
              "http",
              "https"
            ]
          }
        ]
      },
      "signIgnore": [
        "\\.pak$"
      ]
    },
    "dmg": {
      "title": "AdRaze",
      "artifactName": "AdRaze.dmg",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/northcrafto/adraze.git"
  },
  "homepage": "https://adraze.app",
  "bugs": {
    "url": "https://github.com/northcrafto/adraze/issues"
  },
  "productName": "AdRaze"
}
