{
  "cleanUrls": true,
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "adraze.vercel.app" }], "destination": "https://adraze.app/$1", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.adraze.app" }], "destination": "https://adraze.app/$1", "permanent": true }
  ]
}
